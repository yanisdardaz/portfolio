{
  "version": 1,
  "thresholds": { "dangerous": 60, "suspect": 25 },

  "weights": {
    "dangerous_scheme": 100,
    "no_https": 15,
    "ip_host": 35,
    "punycode": 30,
    "userinfo": 35,
    "shortener": 25,
    "shortener_resolved": 0,
    "suspicious_tld": 15,
    "brand_impersonation": 50,
    "gov_impersonation": 45,
    "phishing_keyword": 10,
    "many_subdomains": 10,
    "long_url": 5,
    "many_hyphens": 10,
    "nonstandard_port": 10,
    "free_hosting": 15,
    "official_domain": -25,
    "age_very_new": 50,
    "age_new": 20,
    "age_old": -10,
    "age_unknown": 0,
    "many_redirects": 10,
    "cross_domain_redirect": 10,
    "html_redirect": 15,
    "tls_error": 25,
    "unreachable": 0,
    "blocklisted": 100,
    "file_download": 50,
    "password_form": 20,
    "sms_payload": 20,
    "sms_shortcode": 20,
    "tel_payload": 5,
    "tel_premium": 35,
    "crypto_payment": 40,
    "wifi_open": 15,
    "wifi_payload": 0,
    "email_payload": 5,
    "text_payload": 0,
    "vcard_payload": 0,
    "geo_payload": 0
  },

  "limits": {
    "phishing_keyword_max": 2,
    "subdomain_labels": 4,
    "long_url_chars": 120,
    "hyphens": 3,
    "redirect_hops": 3,
    "age_very_new_days": 30,
    "age_new_days": 180,
    "age_old_days": 365
  },

  "messages": {
    "dangerous_scheme": "Le QR code contient un lien « {scheme} » : il peut exécuter du code ou afficher une fausse page directement dans le navigateur.",
    "no_https": "Le site n'utilise pas HTTPS : les données saisies circulent sans chiffrement.",
    "ip_host": "Le lien pointe vers une adresse IP ({host}) au lieu d'un nom de domaine, une technique courante pour les sites piégés.",
    "punycode": "Le nom de domaine contient des caractères spéciaux (« {host} ») qui peuvent imiter un site connu (attaque par homoglyphes).",
    "userinfo": "Le lien contient un « @ » : tout ce qui est avant est ignoré, et la vraie destination est « {host} ».",
    "shortener": "Lien raccourci ({host}) : la vraie destination est cachée.",
    "shortener_resolved": "Lien raccourci ({host}) : la vraie destination a été retrouvée.",
    "suspicious_tld": "L'extension « .{tld} » est très utilisée par les sites d'arnaque.",
    "brand_impersonation": "Le domaine contient « {brand} » mais ce n'est pas le site officiel ({official}).",
    "gov_impersonation": "Le domaine fait croire à un site du gouvernement, mais les sites officiels se terminent par « .gouv.fr ».",
    "phishing_keyword": "Le lien contient le mot « {word} », fréquent dans les pages de phishing.",
    "many_subdomains": "Le nom de domaine a beaucoup de sous-niveaux ({host}), souvent pour cacher le vrai domaine.",
    "long_url": "Le lien est anormalement long ({length} caractères).",
    "many_hyphens": "Le nom de domaine contient beaucoup de tirets ({host}).",
    "nonstandard_port": "Le lien utilise un port inhabituel ({port}).",
    "free_hosting": "Le site est hébergé sur une plateforme gratuite ({platform}) : n'importe qui peut y créer une page en quelques minutes.",
    "official_domain": "Domaine officiel reconnu : {domain}.",
    "age_very_new": "Le domaine a été créé il y a seulement {days} jour(s).",
    "age_new": "Le domaine est récent : créé il y a {days} jours.",
    "age_old": "Le domaine existe depuis {years} an(s).",
    "age_unknown": "L'âge du domaine n'a pas pu être vérifié.",
    "many_redirects": "Le lien passe par {hops} redirections avant d'arriver à destination.",
    "cross_domain_redirect": "Le lien redirige vers un autre site : {from} → {to}.",
    "html_redirect": "La page redirige automatiquement le visiteur avec du code caché ({kind}).",
    "tls_error": "Le certificat de sécurité du site est invalide ({detail}).",
    "unreachable": "Le site n'a pas répondu ({detail}).",
    "blocklisted": "Ce lien est signalé comme malveillant par : {sources}.",
    "file_download": "Le lien télécharge directement un fichier ({file}). Ne l'installe pas.",
    "password_form": "La page demande un mot de passe alors que le site est récent ou inconnu.",
    "sms_payload": "Le QR code prépare l'envoi d'un SMS au {number}.",
    "sms_shortcode": "Le numéro {number} est un numéro court, souvent surtaxé.",
    "tel_payload": "Le QR code lance un appel vers le {number}.",
    "tel_premium": "Le {number} est un numéro surtaxé.",
    "crypto_payment": "Le QR code demande un paiement en cryptomonnaie ({currency}), un moyen de paiement très utilisé par les arnaqueurs car irréversible.",
    "wifi_open": "Le QR code connecte à un réseau Wi-Fi ouvert (« {ssid} ») : un pirate peut voir ce qui y circule.",
    "wifi_payload": "Le QR code connecte au réseau Wi-Fi « {ssid} ».",
    "email_payload": "Le QR code prépare un e-mail vers {address}.",
    "text_payload": "Le QR code contient seulement du texte.",
    "vcard_payload": "Le QR code contient une fiche de contact.",
    "geo_payload": "Le QR code contient une position GPS."
